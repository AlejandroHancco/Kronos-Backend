# --- Common (api + worker) ---
# Passwords inside DATABASE_URL / REDIS_URL must be percent-encoded if they contain
# @ : / # ? % & etc. (e.g. @ -> %40). Easier: use URL-safe passwords (openssl rand -hex 24).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartconcrete
# Required by both apps; boot fails without it
REDIS_URL=redis://localhost:6379

# --- api ---
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_JWT_SECRET=change-me
# api-only: admission limit for manual measurements. A request is rejected when the
# measurement queue backlog plus its estimated duration would exceed this many seconds (default 900)
SCHEDULER_MAX_BACKLOG_SECONDS=900
DEVICE_TEST_TIMEOUT_MS=5000

# --- worker ---
HEALTH_PORT=3001
DEVICE_LOCK_WAIT_MS=900000
