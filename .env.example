# Copy to .env and adjust. Placeholders only: never commit real secrets.

# --- Shared (api + worker) ---
# Required by both apps; they fail at bootstrap without it. Upstash style: rediss://...
REDIS_URL=redis://localhost:6379
# Postgres; app tables live in the "platform" schema (hence ?schema=platform)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartconcrete?schema=platform

# --- API (apps/api) ---
PORT=3000
# Allowed CORS / Socket.io origin
FRONTEND_URL=http://localhost:5173
# Legacy JWT strategy secret
JWT_SECRET=change-me
# Manual-measurement queue admission limit, seconds (api-only; default 900)
SCHEDULER_MAX_BACKLOG_SECONDS=900

# --- Supabase auth (api) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
# Optional: enables local token verification (no round-trip to Supabase)
SUPABASE_JWT_SECRET=change-me

# --- LaaS service metadata (IEEE 1876, optional; defaults shown) ---
LAAS_TITLE=Kronos LaaS
LAAS_DESCRIPTION=Laboratory as a Service (IEEE 1876)
LAAS_TERMS_URL=http://localhost:5173
LAAS_CONTACT=kronos@localhost
LAAS_LICENSE=Todos los derechos reservados
LAAS_LICENSE_URL=http://localhost:5173
# Public base URL advertised in the service description
LAAS_BASE_URL=http://localhost:3000/laas/v1

# --- Device I/O (used where device calls run: worker; api reads the timeouts too) ---
# Timeout of a device connectivity test (ms)
DEVICE_TEST_TIMEOUT_MS=5000
# Timeout of a single device operation (ms). Must exceed the slowest driver live-op budget
# (Kronos MUX: 3 attempts x 5 s + 2 x 500 ms ~ 16 s)
DEVICE_OP_TIMEOUT_MS=25000
# Max time a job waits for the per-device lock (ms)
DEVICE_LOCK_WAIT_MS=900000

# --- Worker (apps/worker) ---
# Health endpoint port
HEALTH_PORT=3001
