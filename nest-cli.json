{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "deleteOutDir": true
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "realtime": {
      "type": "library",
      "root": "libs/realtime",
      "entryFile": "index",
      "sourceRoot": "libs/realtime/src",
      "compilerOptions": {
        "tsConfigPath": "libs/realtime/tsconfig.lib.json"
      }
    },
    "laas-catalog": {
      "type": "library",
      "root": "libs/laas-catalog",
      "entryFile": "index",
      "sourceRoot": "libs/laas-catalog/src",
      "compilerOptions": {
        "tsConfigPath": "libs/laas-catalog/tsconfig.lib.json"
      }
    },
    "device-drivers": {
      "type": "library",
      "root": "libs/device-drivers",
      "entryFile": "index",
      "sourceRoot": "libs/device-drivers/src",
      "compilerOptions": {
        "tsConfigPath": "libs/device-drivers/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "queue": {
      "type": "library",
      "root": "libs/queue",
      "entryFile": "index",
      "sourceRoot": "libs/queue/src",
      "compilerOptions": {
        "tsConfigPath": "libs/queue/tsconfig.lib.json"
      }
    },
    "notifications": {
      "type": "library",
      "root": "libs/notifications",
      "entryFile": "index",
      "sourceRoot": "libs/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "libs/notifications/tsconfig.lib.json"
      }
    },
    "measurement": {
      "type": "library",
      "root": "libs/measurement",
      "entryFile": "index",
      "sourceRoot": "libs/measurement/src",
      "compilerOptions": {
        "tsConfigPath": "libs/measurement/tsconfig.lib.json"
      }
    },
    "experiments": {
      "type": "library",
      "root": "libs/experiments",
      "entryFile": "index",
      "sourceRoot": "libs/experiments/src",
      "compilerOptions": {
        "tsConfigPath": "libs/experiments/tsconfig.lib.json"
      }
    }
  }
}
