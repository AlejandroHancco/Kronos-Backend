# Single-VM deployment (all services on the "app" VM). Copy to .env and fill in.
# Use URL-safe passwords (e.g. `openssl rand -hex 24`): they are embedded in URLs.

# --- Postgres / Redis (internal to the compose network) ---
POSTGRES_USER=kronos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartconcrete
REDIS_PASSWORD=change-me

# --- URLs (replace 10.20.12.190 with a public domain when one exists) ---
FRONTEND_URL=http://10.20.12.190
VITE_API_URL=http://10.20.12.190:3000
VITE_PUBLIC_URL=http://10.20.12.190
LAAS_BASE_URL=http://10.20.12.190:3000/laas/v1

# --- Auth ---
JWT_SECRET=change-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_JWT_SECRET=change-me
# Frontend build args (public by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=change-me

# --- Tuning ---
PORT=3000
SCHEDULER_MAX_BACKLOG_SECONDS=900
DEVICE_TEST_TIMEOUT_MS=5000
DEVICE_OP_TIMEOUT_MS=25000
# Scheduled points processed at once by the worker (default 4); at least the number of distinct
# devices that can have points at the same time.
SCHEDULED_CONCURRENCY=4

# --- LaaS service metadata (IEEE 1876) ---
LAAS_TITLE=Kronos LaaS
LAAS_DESCRIPTION=Laboratory as a Service (IEEE 1876)
LAAS_TERMS_URL=http://10.20.12.190
LAAS_CONTACT=kronos@example.com
LAAS_LICENSE=Todos los derechos reservados
LAAS_LICENSE_URL=http://10.20.12.190

# --- Email verification (Brevo; empty BREVO_API_KEY = dev mode, the link is only logged) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Kronos
EMAIL_VERIFICATION_TTL_HOURS=24
