# --- Caddy / domains ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# --- Frontend build args (baked at build time) ---
VITE_API_URL=https://api.example.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=change-me
VITE_PUBLIC_URL=https://app.example.com

# --- api ---
# <data-private-ip> = private IP of vm-data
# App tables live in Postgres schema "platform" (?schema=platform).
# Passwords inside DATABASE_URL / REDIS_URL must be percent-encoded if they contain
# @ : / # ? % & etc. (e.g. @ -> %40). Easier: use URL-safe passwords (openssl rand -hex 24).
DATABASE_URL=postgresql://postgres:CHANGE_ME@<data-private-ip>:5432/smartconcrete?schema=platform
# Redis requires a password: redis://:PASSWORD@<data-private-ip>:6379
REDIS_URL=redis://:CHANGE_ME@<data-private-ip>:6379
PORT=3000
FRONTEND_URL=https://app.example.com
JWT_SECRET=change-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_JWT_SECRET=change-me
# Manual-measurement queue admission limit, seconds (api-only)
SCHEDULER_MAX_BACKLOG_SECONDS=900
DEVICE_TEST_TIMEOUT_MS=5000
# Must exceed the slowest driver live-op budget (Kronos MUX ~ 16 s)
DEVICE_OP_TIMEOUT_MS=25000

# --- LaaS service metadata (IEEE 1876, optional) ---
LAAS_TITLE=Kronos LaaS
LAAS_DESCRIPTION=Laboratory as a Service (IEEE 1876)
LAAS_TERMS_URL=https://app.example.com
LAAS_CONTACT=kronos@example.com
LAAS_LICENSE=Todos los derechos reservados
LAAS_LICENSE_URL=https://app.example.com
LAAS_BASE_URL=https://api.example.com/laas/v1
