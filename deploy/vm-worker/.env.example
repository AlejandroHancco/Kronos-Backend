# <data-private-ip> = private IP of vm-data
# App tables live in Postgres schema "platform" (?schema=platform).
# Passwords inside DATABASE_URL / REDIS_URL must be percent-encoded if they contain
# @ : / # ? % & etc. (e.g. @ -> %40). Easier: use URL-safe passwords (openssl rand -hex 24).
DATABASE_URL=postgresql://postgres:CHANGE_ME@<data-private-ip>:5432/smartconcrete?schema=platform
# Redis requires a password: redis://:PASSWORD@<data-private-ip>:6379
REDIS_URL=redis://:CHANGE_ME@<data-private-ip>:6379
# Host-bound (network_mode: host). Firewall this port; do NOT expose publicly.
HEALTH_PORT=3001
DEVICE_LOCK_WAIT_MS=900000
DEVICE_TEST_TIMEOUT_MS=5000
# Must exceed the slowest driver live-op budget (Kronos MUX ~ 16 s)
DEVICE_OP_TIMEOUT_MS=25000
