# Private IP of this VM (ports are bound only to it)
PRIVATE_IP=10.0.0.10
POSTGRES_USER=postgres
# POSTGRES_PASSWORD / REDIS_PASSWORD are reused inside DATABASE_URL / REDIS_URL on vm-app and
# vm-worker: prefer URL-safe values (openssl rand -hex 24); otherwise percent-encode @ : / # etc. there.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smartconcrete
REDIS_PASSWORD=CHANGE_ME
